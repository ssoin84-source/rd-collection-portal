generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("NETLIFY_DB_URL")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model Customer {
  id              String         @id @default(cuid())
  customerName    String
  accountNumber   String         @unique
  denomination    Decimal        @db.Decimal(12, 2)
  openingDate     DateTime
  monthPaidUpto   DateTime
  penalty         Decimal        @default(0) @db.Decimal(12, 2)
  status          CustomerStatus @default(ACTIVE)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  transactions    Transaction[]
  loginLinks      CustomerLoginAccount[]
  lotItems        LotItem[]

  @@index([status])
}

model Transaction {
  id              String    @id @default(cuid())
  customerId      String
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(12, 2)
  transactionDate DateTime  @default(now())
  note            String?
  lotId           String?
  lot             Lot?      @relation(fields: [lotId], references: [id])
  createdAt       DateTime  @default(now())

  @@index([customerId])
  @@index([lotId])
}

model Lot {
  id                 String        @id @default(cuid())
  lotReferenceNumber String        @unique
  uploadDate         DateTime      @default(now())
  createdAt          DateTime      @default(now())
  items              LotItem[]
  transactions       Transaction[]
}

model LotItem {
  id             String   @id @default(cuid())
  lotId          String
  lot            Lot      @relation(fields: [lotId], references: [id], onDelete: Cascade)
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id])
  accountNumber  String
  customerName   String
  denomination   Decimal  @db.Decimal(12, 2)
  depositAmount  Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())
}

model CustomerLogin {
  id           String                 @id @default(cuid())
  username     String                 @unique
  passwordHash String
  enabled      Boolean                @default(true)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  accounts     CustomerLoginAccount[]
}

model CustomerLoginAccount {
  id         String        @id @default(cuid())
  loginId    String
  customerId String
  login      CustomerLogin @relation(fields: [loginId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([loginId, customerId])
}

model Setting {
  key   String @id
  value String
}
