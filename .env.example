# PostgreSQL connection string (Neon recommended - works natively with Netlify DB)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin credentials (as per spec, hardcoded via env - change in production)
ADMIN_ID="Admin123"
ADMIN_PASSWORD="Admin@123"

# Secret used to sign session cookies - generate with: openssl rand -base64 32
AUTH_SECRET="replace-this-with-a-long-random-string"
